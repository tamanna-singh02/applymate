# The AI engine is your local Claude Code CLI (`claude -p`). No API key is needed;
# it uses the account you are logged into in Claude Code.

# Optional: full path to the claude executable if `claude` is not on PATH.
# CLAUDE_CLI_PATH=C:\Users\<you>\.local\bin\claude.exe

# Optional: model alias or ID passed to `claude --model` (e.g. opus, sonnet, claude-opus-5-5).
# Leave unset to use your Claude Code default.
# CLAUDE_MODEL=

# Optional: per-step timeout in seconds (default 600).
# CLAUDE_TIMEOUT_SECONDS=600

# LaTeX (only needed for Overleaf/.tex resumes)
# LATEX_BIN_DIR=C:\Users\<you>\AppData\Local\Programs\MiKTeX\miktex\bin\x64
# LATEX_ENGINE=pdflatex   # or xelatex; default: auto-detect
# LATEX_TIMEOUT_SECONDS=240
